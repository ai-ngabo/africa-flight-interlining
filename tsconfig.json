{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pai/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "services/*/src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
