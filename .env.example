# Copy to .env (optional). Every variable is optional: without them each service
# falls back to an in-process implementation so the whole platform runs for free
# on a laptop with only Node.js + Python.

# --- Shared secrets (CHANGE in any non-local environment) ---
OFFER_SIGNING_SECRET=dev-offer-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
INTERNAL_API_KEY=dev-internal-key-change-me

# --- Service URLs (defaults shown) ---
SEARCH_URL=http://localhost:4001
BOOKING_URL=http://localhost:4002
PAYMENT_URL=http://localhost:4003
INTEL_URL=http://localhost:8000

# --- Optional free infrastructure (docker compose up -d neo4j redis postgres chroma ollama) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=localpassword
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://pai:pai@localhost:5432/pai
# CHROMA_URL=http://localhost:8001
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Live FX (free, no key): https://open.er-api.com ---
# FX_LIVE=1

# --- MTN MoMo sandbox (free: https://momodeveloper.mtn.com) ---
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=

# --- Safaricom M-Pesa Daraja sandbox (free: https://developer.safaricom.co.ke) ---
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=174379
# MPESA_CALLBACK_URL=https://example.com/mpesa/callback
